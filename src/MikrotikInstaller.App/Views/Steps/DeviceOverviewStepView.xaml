<UserControl x:Class="MikrotikInstaller.App.Views.Steps.DeviceOverviewStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:MikrotikInstaller.App.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="600">
    <StackPanel Margin="0,16,0,0">
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,24" Opacity="0.8" />

        <StackPanel Orientation="Horizontal" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0" />
            <TextBlock Text="Gerät wird ausgelesen …" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource MikrotikRedBrush}" Margin="0,0,0,12" />
            <ui:Button Content="Erneut versuchen" Appearance="Secondary" HorizontalAlignment="Left"
                       Command="{Binding RetryCommand}" />
        </StackPanel>

        <StackPanel Visibility="{Binding Device, Converter={StaticResource NullToVisibilityConverter}}">
            <ui:CardExpander IsExpanded="True" Margin="0,0,0,16">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Router24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="{Binding Device.IdentityName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Device.BoardModel}" Opacity="0.6" FontSize="12" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="8,12,8,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RouterOS-Version: " FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Device.RouterOsVersion}" />
                        <controls:InfoHint Text="RouterOS ist das Betriebssystem, das auf MikroTik-Geräten läuft – vergleichbar mit Windows auf einem PC." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Architektur: " FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Device.Architecture}" />
                        <controls:InfoHint Text="Die Art des Prozessors in deinem Gerät. Für die Einrichtung nicht wichtig, nur zur Information." />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="WLAN-fähig: " FontWeight="SemiBold" />
                        <Run Text="{Binding Device.HasWireless}" />
                    </TextBlock>
                </StackPanel>
            </ui:CardExpander>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Netzwerkschnittstellen" FontWeight="SemiBold" />
                <controls:InfoHint Text="Die Anschlüsse und Verbindungen deines Routers, z. B. Netzwerkkabel-Ports (Ethernet) oder WLAN. Darüber verbindest du später Geräte und das Internet." />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Interfaces}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                <TextBlock Grid.Column="1" Text="{Binding KindLabel}" Opacity="0.6" Margin="0,0,16,0" />
                                <TextBlock Grid.Column="2" Text="{Binding StatusLabel}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
