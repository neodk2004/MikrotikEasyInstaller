<UserControl x:Class="MikrotikInstaller.App.Views.Steps.SummaryStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="600">
    <StackPanel Margin="0,16,0,0">
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,20" Opacity="0.8" />

        <StackPanel Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,20">
            <TextBlock Text="Fertig! Dein Gerät wurde erfolgreich eingerichtet." FontWeight="SemiBold" Foreground="{StaticResource MikrotikAccentBrush}" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8">
                <Run Text="Falls doch mal etwas nicht passt: Auf deinem Gerät liegt unter dem Namen „" />
                <Run Text="{Binding BackupName}" FontWeight="SemiBold" />
                <Run Text="“ eine Sicherung deines vorherigen Zustands." />
            </TextBlock>
        </StackPanel>

        <StackPanel Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <TextBlock Text="Das richten wir für dich ein" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardExpander IsExpanded="True" Margin="0,0,0,10">
                            <ui:CardExpander.Icon>
                                <ui:SymbolIcon Symbol="{Binding Icon}" Foreground="{StaticResource MikrotikAccentBrush}" />
                            </ui:CardExpander.Icon>
                            <ui:CardExpander.Header>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </ui:CardExpander.Header>
                            <ItemsControl ItemsSource="{Binding Lines}" Margin="8,10,8,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Top">
                                            <Border Width="5" Height="5" CornerRadius="2.5" Background="{StaticResource MikrotikAccentBrush}"
                                                    Margin="0,7,10,0" VerticalAlignment="Top" />
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ui:CardExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Button Content="Jetzt einrichten" Appearance="Primary" Margin="0,0,8,0"
                           Command="{Binding ApplyCommand}" />
                <ui:Button Content="Als PDF speichern" Appearance="Secondary"
                           Command="{Binding ExportPdfCommand}" />
            </StackPanel>
        </StackPanel>

        <ui:Button Content="Als PDF speichern" Appearance="Secondary" HorizontalAlignment="Left" Margin="0,0,0,0"
                   Command="{Binding ExportPdfCommand}"
                   Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibilityConverter}}" />

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                    Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisibilityConverter}}">
            <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0" />
            <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource MikrotikRedBrush}" Margin="0,16,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

        <TextBlock Text="{Binding PdfExportMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Visibility="{Binding PdfExportMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource MikrotikAccentBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PdfExportIsError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource MikrotikRedBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
