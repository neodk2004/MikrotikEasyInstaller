<UserControl x:Class="MikrotikInstaller.App.Views.Controls.InfoHint"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root"
             VerticalAlignment="Center"
             Margin="5,0,0,0">
    <!-- ToolTip-Inhalte hängen nicht im normalen visuellen Baum der Seite, daher funktioniert eine
         einfache ElementName-Bindung darin nicht. Der Umweg über Tag + PlacementTarget ist das dafür
         vorgesehene WPF-Muster. -->
    <ui:SymbolIcon Symbol="QuestionCircle16" FontSize="14" Opacity="0.55" Cursor="Help"
                   Tag="{Binding Text, ElementName=Root}"
                   ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="60000">
        <ui:SymbolIcon.ToolTip>
            <ToolTip MaxWidth="280">
                <TextBlock Text="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}}" TextWrapping="Wrap" />
            </ToolTip>
        </ui:SymbolIcon.ToolTip>
    </ui:SymbolIcon>
</UserControl>
