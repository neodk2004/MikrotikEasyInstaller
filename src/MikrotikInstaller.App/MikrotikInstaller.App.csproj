<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MikrotikInstaller.Core\MikrotikInstaller.Core.csproj" />
  </ItemGroup>

  <!-- Als Resource statt Content/CopyToOutput, damit die Datei beim Single-File-Publish mit in
       die exe eingebettet wird und über pack://application:,,,/Assets/app.ico ansprechbar bleibt. -->
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>MikroTik-Installer</AssemblyName>
    <AssemblyTitle>MikroTik Installer</AssemblyTitle>
    <Product>MikroTik Installer</Product>
    <Company>MikroTik Installer</Company>
    <Description>Interview-Assistent für die Grundeinrichtung von MikroTik-Geräten.</Description>
    <Version>1.0.0</Version>
    <NeutralLanguage>de-DE</NeutralLanguage>
    <!-- Wird in die exe kompiliert: Datei-Icon in Explorer/Taskleiste/Alt-Tab. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Nur diese Sprachpakete der .NET-Laufzeit/Abhängigkeiten mitliefern (übersetzte
         Systemmeldungen, nicht unsere eigenen UI-Texte) — spart etliche MB an Sprachen,
         die die App ohnehin nie anzeigt. -->
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Standardwerte für "dotnet publish": eine einzelne, in sich geschlossene .exe ohne separate
       .NET-Runtime-Installation beim Nutzer. Ohne diese Property-Group müsste jeder Aufruf die
       Optionen einzeln als -p:... angeben. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Debug-Symbole in die exe einbetten statt als separate .pdb-Dateien danebenzulegen —
         am Ende soll wirklich nur eine einzige Datei zum Weitergeben übrig bleiben. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
