<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- windows statt net8.0: die Tests rufen u. a. SummaryPdfExporter.Export auf, das als
         [SupportedOSPlatform("windows")] markiert ist (PDFsharp/GDI+). Ohne windows-TFM kennt
         der Plattform-Analyzer den Kontext nicht und meldet CA1416 an jeder Aufrufstelle,
         obwohl die gesamte Lösung ohnehin ein Windows/WPF-Projekt ist. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MikrotikInstaller.Core\MikrotikInstaller.Core.csproj" />
  </ItemGroup>

</Project>
